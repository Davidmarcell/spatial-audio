{
  "name": "saudade",
  "description": "Saudade — interactive ambient soundscape composer with spatial Web Audio, globe.gl map, and museum-sourced tiles.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:stable": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "npm run validate:audio && npm run validate:uniqueness && npm run validate:image-uniqueness && npm run test:place-naming && npm run test:scene-matrix && npm run test:hanoi && npm run test:audio-engine && tsc -b && vite build",
    "build:portfolio": "npm run validate:audio && npm run validate:uniqueness && npm run validate:image-uniqueness && npm run test:place-naming && npm run test:scene-matrix && npm run test:hanoi && npm run test:audio-engine && tsc -b && vite build --base=/spatial-audio/",
    "lint": "eslint .",
    "preview": "vite preview",
    "serve": "vite preview",
    "start": "npm run build && vite preview",
    "validate:audio": "node scripts/validate-audio.mjs",
    "validate:uniqueness": "node --import tsx scripts/validate-uniqueness.ts",
    "validate:image-uniqueness": "node --import tsx scripts/validate-image-uniqueness.ts",
    "test:place-naming": "node --import tsx scripts/test-place-naming.ts",
    "test:scene-matrix": "node --import tsx scripts/test-scene-matrix.ts",
    "test:hanoi": "node --import tsx scripts/test-hanoi-soundscape.ts",
    "test:audio-engine": "node --import tsx scripts/test-audio-engine.ts",
    "snapshot:scene-matrix": "UPDATE_SNAPSHOT=1 node --import tsx scripts/test-scene-matrix.ts",
    "download:audio": "bash scripts/download-audio.sh",
    "download:audio:variants": "node scripts/download-audio-variants.mjs",
    "download:icons": "node scripts/download-met-icons.mjs",
    "download:location-art": "node scripts/download-location-art.mjs",
    "nypl:search": "node scripts/nypl-search.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@silk-hq/components": "^0.10.1",
    "cobe": "^2.0.1",
    "globe.gl": "^2.46.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
